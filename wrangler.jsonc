{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jefferyho-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first so it can redirect www before serving assets.
    "run_worker_first": true
  },
  // Only /v2 belongs to this Worker; the catch-all routes stay on the notion2 Worker.
  "routes": [
    { "pattern": "jefferyho.com/v2*", "zone_name": "jefferyho.com" },
    { "pattern": "www.jefferyho.com/v2*", "zone_name": "jefferyho.com" }
  ]
}
