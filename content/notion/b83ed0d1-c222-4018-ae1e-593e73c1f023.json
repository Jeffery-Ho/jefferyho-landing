    ],
    [
     "单线程三级结构",
     [
      [
       "b"
      ]
     ]
    ],
    [
     "；"
    ]
   ]
  },
  {
   "t": "text",
   "id": "41469fda-a4de-4565-9e1d-ca7842ee8fe0",
   "r": [
    [
     "2、主流证券交易系统均"
    ],
    [
     "无常驻书签栏功能",
     [
      [
       "b"
      ]
     ]
    ],
    [
