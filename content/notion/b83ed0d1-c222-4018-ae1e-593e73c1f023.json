  },
  {
   "t": "text",
   "id": "8db72f3d-c37e-4c9c-8200-11bce5dabdf9",
   "r": [
    [
     "3、如何"
    ],
    [
     "缩短层级",
     [
      [
       "b"
      ]
     ]
    ],
    [
     "、如何发挥"
    ],
    [
     "菜单栏与常驻书签栏的优势配合",
     [
      [
       "b"
      ]
     ]
    ],
    [
     "，是优化的突破点。"
    ]
   ]
  },
  {
   "t": "sub_sub_header",
   "id": "2edce2ef-35a5-4c0f-afe6-9b5ce365c59b",
   "r": [
    [
     "优化方案1",
     [
      [
       "b"
      ]
     ]
    ]
   ]
  },
